# Copy this file to .env and fill in real values.

# --- Core ---
SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Database (leave DB_ENGINE=sqlite for local dev) ---
DB_ENGINE=sqlite
# DB_ENGINE=postgres
# DB_NAME=codeiq
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# --- Google OAuth (django-allauth) ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://127.0.0.1:8000/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Razorpay ---
# Get test keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- CORS (comma separated, optional) ---
CORS_ALLOWED_ORIGINS=
